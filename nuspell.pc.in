prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@PKGCONFIG_LIBDIR@
includedir=${prefix}/@PKGCONFIG_INCLUDEDIR@

Name: @PROJECT_NAME@
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lnuspell
Requires: icu-uc
Cflags: -I${includedir}
